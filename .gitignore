# Build outputs
bin/
obj/
*.exe
*.o
*.a
*.pdb
*.ilk

# Temporary directories and caches
*.tmp
TestResults/
TestOutput/
dist/*.zip
dist/app/
dist/LocalClip-*/
.vs/
.idea/

# Pinned runtime binaries (can be extracted/restored via tools setup)
tools/obs/runtime/
tools/ffmpeg/*.exe
tools/obs/*.cpp

# Local user-generated QA screenshots/logs and trace evidence (never publish)
qa-evidence/
dist/qa-local/
Flick-Visual-QA-*/
*.trx

# Generated icon, per-user Windows installer and per-build checksums.
src/LocalClip.App/Assets/Brand/Flick.ico
dist/Flick.ico
dist/Flick-Setup-*.exe
dist/SHA256SUMS.txt

# Only temporary Artifact Signing account metadata (NOT credentials) is kept
# locally and is never committed alongside distributable binaries.
dist/signing/
