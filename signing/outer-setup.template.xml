<?xml version="1.0" encoding="utf-8"?>
<!-- Signs only the outer PE. Its payload and uninstaller must already be verified. -->
<artifact-configuration
    xmlns="http://signpath.io/artifact-configuration/v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://signpath.io/artifact-configuration/v1 https://app.signpath.io/Web/artifact-configuration/v1.xsd">
  <parameters>
    <parameter name="productVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Flick-Setup.exe" min-matches="1" max-matches="1"
             product-name="Flick" product-version="${productVersion}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
