#include <windows.h>
#include "capture_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FLICK_FILE_VERSION
 PRODUCTVERSION FLICK_PRODUCT_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Flick contributors\0"
            VALUE "FileDescription", "Flick Capture Host\0"
            VALUE "FileVersion", FLICK_FILE_VERSION_STRING "\0"
            VALUE "InternalName", "Flick.CaptureHost\0"
            VALUE "OriginalFilename", "LocalClip.CaptureHost.exe\0"
            VALUE "ProductName", "Flick\0"
            VALUE "ProductVersion", FLICK_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
