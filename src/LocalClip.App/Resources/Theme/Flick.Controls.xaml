<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Quiet desktop controls share neutral surfaces; primary actions carry the accent. -->

    <Style x:Key="Flick.Surface.Panel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Flick.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Flick.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Flick.Corner.Panel}"/>
        <Setter Property="Padding" Value="{StaticResource Flick.Inset.Panel}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Flick.Surface.Frosted" TargetType="{x:Type Border}" BasedOn="{StaticResource Flick.Surface.Panel}">
        <Setter Property="Background" Value="{DynamicResource Flick.Brush.Frosted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Flick.Brush.Border}"/>
    </Style>
    <Style x:Key="Flick.Surface.Toast" TargetType="{x:Type Border}" BasedOn="{StaticResource Flick.Surface.Panel}">
        <Setter Property="Background" Value="{DynamicResource Flick.Brush.Toast}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Flick.Brush.Border}"/>
        <Setter Property="Padding" Value="{StaticResource Flick.Inset.Toast}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Flick.Corner.Popover}"/>
    </Style>

    <Style x:Key="Flick.Button.Base" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Flick.Brush.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Flick.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Flick.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Control}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="{StaticResource Flick.Size.Control}"/>
        <Setter Property="MinWidth" Value="68"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            CornerRadius="{StaticResource Flick.Corner.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value=".96"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value=".82"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Flick.Brush.Focus}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".43"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Flick.Brush.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Flick.Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Flick.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Flick.Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.OnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Flick.Brush.Accent}"/>
        <Setter Property="MinHeight" Value="{StaticResource Flick.Size.PrimaryButton}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Flick.Brush.AccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Flick.Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Flick.Button.Base}"/>
    <Style x:Key="Flick.Button.Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource Flick.Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="Flick.Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource Flick.Button.Ghost}">
        <Setter Property="Width" Value="{StaticResource Flick.Size.IconButton}"/>
        <Setter Property="Height" Value="{StaticResource Flick.Size.IconButton}"/>
        <Setter Property="MinHeight" Value="{StaticResource Flick.Size.IconButton}"/>
        <Setter Property="MinWidth" Value="{StaticResource Flick.Size.IconButton}"/>
        <Setter Property="Padding" Value="7"/>
    </Style>
    <Style x:Key="Flick.Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Flick.Button.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.Danger}"/>
    </Style>
    <Style x:Key="Flick.Button.Busy" TargetType="{x:Type Button}" BasedOn="{StaticResource Flick.Button.Primary}">
        <Setter Property="IsEnabled" Value="False"/>
    </Style>

    <Style x:Key="Flick.Input.Text" TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="{StaticResource Flick.Size.Control}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Background" Value="{DynamicResource Flick.Brush.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Flick.Brush.BorderStrong}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
        <Setter Property="SelectionOpacity" Value=".65"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Flick.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Flick.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="TextChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Flick.Corner.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="TextChrome" Property="BorderBrush" Value="{DynamicResource Flick.Brush.Focus}"/>
                            <Setter TargetName="TextChrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextChrome" Property="Opacity" Value=".94"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Native ComboBox behavior retained; only one themed input chrome. -->
    <Style x:Key="Flick.Input.ComboItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Flick.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Control}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Flick.Corner.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background"
                                    Value="{DynamicResource Flick.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background"
                                    Value="{DynamicResource Flick.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Flick.Input.Combo" TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="{StaticResource Flick.Size.Control}"/>
        <Setter Property="MinWidth" Value="126"/>
        <Setter Property="Background" Value="{DynamicResource Flick.Brush.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Flick.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Flick.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Control}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Flick.Input.ComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <!-- Prevent an unusually long game/window title from painting
                         across neighboring capture or settings controls. -->
                    <Grid ClipToBounds="True">
                        <ToggleButton x:Name="DropButton" Focusable="False"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border CornerRadius="{StaticResource Flick.Corner.Control}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="11,0,32,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"/>
                        <Path Data="M 0,0 L 4,4 8,0" Stroke="{DynamicResource Flick.Brush.TextSecondary}"
                              StrokeThickness="1.5" Width="9" Height="5" Stretch="Fill"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,12,0" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=DropButton}"
                               IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False"
                               AllowsTransparency="True" Focusable="False">
                            <Border MinWidth="{Binding ActualWidth, ElementName=DropButton}"
                                    MaxHeight="260" Padding="5"
                                    Background="{DynamicResource Flick.Brush.Surface}"
                                    BorderBrush="{DynamicResource Flick.Brush.Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource Flick.Corner.Popover}">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="DropButton" Property="BorderBrush" Value="{DynamicResource Flick.Brush.Focus}"/>
                            <Setter TargetName="DropButton" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Flick.Toggle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Flick.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Body}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid MinHeight="32" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="22" VerticalAlignment="Center">
                                <Border x:Name="ToggleTrack" CornerRadius="11" BorderThickness="1"
                                        Background="{DynamicResource Flick.Brush.Raised}"
                                        BorderBrush="{DynamicResource Flick.Brush.Border}"/>
                                <Ellipse x:Name="ToggleThumb" Width="16" Height="16" HorizontalAlignment="Left"
                                         VerticalAlignment="Center" Margin="3,0,0,0"
                                         Fill="{DynamicResource Flick.Brush.TextSecondary}"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding Content}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource Flick.Brush.BorderStrong}"/>
                            <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource Flick.Brush.BorderStrong}"/>
                            <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="ToggleThumb" Property="Fill" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource Flick.Brush.Focus}"/>
                            <Setter TargetName="ToggleTrack" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Flick.Slider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Ellipse Width="12" Height="12"
                                 Fill="{DynamicResource Flick.Brush.TextPrimary}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Flick.Slider.TrackFilled" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="Transparent">
                        <Border Height="3" Background="{DynamicResource Flick.Brush.TextSecondary}"
                                CornerRadius="2" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Flick.Slider.TrackEmpty" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="Transparent">
                        <Border Height="3" Background="{DynamicResource Flick.Brush.Border}"
                                CornerRadius="2" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Flick.Input.Slider" TargetType="{x:Type Slider}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Border x:Name="SliderFocus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <Grid Height="32">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Flick.Slider.TrackFilled}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Flick.Slider.TrackEmpty}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Flick.Slider.Thumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="SliderFocus" Property="BorderBrush" Value="{DynamicResource Flick.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Flick.Progress" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource Flick.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- Single compact and keyboard-focusable segmented source filter. -->
    <Style x:Key="Flick.Library.FilterTrack" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Flick.Brush.Canvas}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Flick.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Flick.Library.FilterChip" TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="{StaticResource Flick.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Caption}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Chip" Padding="10,4" CornerRadius="4"
                            BorderThickness="1" BorderBrush="Transparent"
                            Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background"
                                    Value="{DynamicResource Flick.Brush.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background"
                                    Value="{DynamicResource Flick.Brush.Hover}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Flick.Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush"
                                    Value="{DynamicResource Flick.Brush.Focus}"/>
                            <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Flick.Library.List" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
    </Style>
    <Style x:Key="Flick.Library.Item" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemChrome"
                            BorderBrush="Transparent" BorderThickness="1"
                            Background="Transparent" CornerRadius="6">
                        <ContentPresenter Margin="0"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background"
                                    Value="{DynamicResource Flick.Brush.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background"
                                    Value="{DynamicResource Flick.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemChrome" Property="BorderBrush"
                                    Value="{DynamicResource Flick.Brush.Focus}"/>
                            <Setter TargetName="ItemChrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
