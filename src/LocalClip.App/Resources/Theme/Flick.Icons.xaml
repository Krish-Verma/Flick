<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Authored geometry, not platform-owned symbol assets. A single quiet
         1.5-DIP line family keeps desktop tools optically consistent. -->
    <StreamGeometry x:Key="Flick.Icon.Geometry.Library">M 5,3.5 L 15,3.5 Q 17,3.5 17,5.5 L 17,14.5 Q 17,16.5 15,16.5 L 5,16.5 Q 3,16.5 3,14.5 L 3,5.5 Q 3,3.5 5,3.5 Z M 7.5,3.5 L 7.5,16.5 M 10.5,7.5 L 14,7.5 M 10.5,11.5 L 14,11.5</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Settings">M 8.5,2 L 11.5,2 L 12,4 L 13.5,4.8 L 15.5,4.2 L 17,6.8 L 15.5,8.2 L 15.5,10 L 17,11.5 L 15.5,14.1 L 13.5,13.5 L 12,14.3 L 11.5,16.4 L 8.5,16.4 L 8,14.3 L 6.5,13.5 L 4.5,14.1 L 3,11.5 L 4.5,10 L 4.5,8.2 L 3,6.8 L 4.5,4.2 L 6.5,4.8 L 8,4 Z M 12.5,9.2 A 2.5,2.5 0 1 1 7.5,9.2 A 2.5,2.5 0 1 1 12.5,9.2</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Refresh">M 15.8,6.5 A 6.5,6.5 0 1 0 16.4,12 M 15.8,2.8 L 15.8,6.5 L 12,6.5</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Trim">M 6.6,6.4 L 16.5,16 M 6.6,13.6 L 16.5,4 M 7,5 A 2.5,2.5 0 1 1 2,5 A 2.5,2.5 0 1 1 7,5 M 7,15 A 2.5,2.5 0 1 1 2,15 A 2.5,2.5 0 1 1 7,15</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Audio">M 3,7.5 L 6.5,7.5 L 11,4 L 11,16 L 6.5,12.5 L 3,12.5 Z M 14,7 A 4.4,4.4 0 0 1 14,13 M 16.5,4.5 A 7.8,7.8 0 0 1 16.5,15.5</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Original">M 4,5 L 12,5 Q 13.5,5 13.5,6.5 L 13.5,13.5 Q 13.5,15 12,15 L 4,15 Q 2.5,15 2.5,13.5 L 2.5,6.5 Q 2.5,5 4,5 Z M 13.5,8 L 17.5,5.8 L 17.5,14.2 L 13.5,12</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Share">M 4,8 L 4,15.5 Q 4,17.5 6,17.5 L 14,17.5 Q 16,17.5 16,15.5 L 16,8 M 10,12 L 10,2.5 M 6.5,6 L 10,2.5 L 13.5,6</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Play">M 6,3.5 L 15.5,10 L 6,16.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Pause">M 6.5,4 L 6.5,16 M 13.5,4 L 13.5,16</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.ChevronDown">M 5.5,7.5 L 10,12 L 14.5,7.5</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Back">M 11,4.5 L 5.5,10 L 11,15.5 M 5.5,10 L 16.5,10</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.More">M 4.7,10 A .7,.7 0 1 1 3.3,10 A .7,.7 0 1 1 4.7,10 M 10.7,10 A .7,.7 0 1 1 9.3,10 A .7,.7 0 1 1 10.7,10 M 16.7,10 A .7,.7 0 1 1 15.3,10 A .7,.7 0 1 1 16.7,10</StreamGeometry>
    <StreamGeometry x:Key="Flick.Icon.Geometry.Plus">M 10,4 L 10,16 M 4,10 L 16,10</StreamGeometry>

    <Style x:Key="Flick.Icon.Symbol" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource Flick.Brush.TextSecondary}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Keep the family neutral at rest. A small brand stroke marks intent
         and the existing open-tool state; no new interaction state is owned. -->
    <Style x:Key="Flick.Icon.Tool" TargetType="{x:Type Path}" BasedOn="{StaticResource Flick.Icon.Symbol}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource Flick.Brush.BrandAccent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource Flick.Brush.BrandAccent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="Open">
                <Setter Property="Stroke" Value="{DynamicResource Flick.Brush.BrandAccent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="False">
                <Setter Property="Stroke" Value="{DynamicResource Flick.Brush.TextMuted}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Flick.IconText.Playback">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path x:Name="PlaybackSymbol" Style="{StaticResource Flick.Icon.Symbol}" Data="{StaticResource Flick.Icon.Geometry.Play}" Width="13" Height="13" Margin="0,0,7,0"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <TextBlock Text="{Binding}" Style="{StaticResource Flick.Text.Control}" VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="Pause">
                <Setter TargetName="PlaybackSymbol" Property="Data" Value="{StaticResource Flick.Icon.Geometry.Pause}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="Flick.IconText.PreviewMode">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding}" Style="{StaticResource Flick.Text.Control}" VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <Path Style="{StaticResource Flick.Icon.Symbol}" Data="{StaticResource Flick.Icon.Geometry.ChevronDown}" Width="9" Height="6" Margin="7,1,0,0"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Flick.IconText.Back">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Style="{StaticResource Flick.Icon.Symbol}" Data="{StaticResource Flick.Icon.Geometry.Back}" Width="13" Height="13" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding}" Style="{StaticResource Flick.Text.Control}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Flick.IconText.Add">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Style="{StaticResource Flick.Icon.Symbol}" Data="{StaticResource Flick.Icon.Geometry.Plus}" Width="11" Height="11" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding}" Style="{StaticResource Flick.Text.Control}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
