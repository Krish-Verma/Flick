<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Flick.Text.Base" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Flick.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="Flick.Text.PageTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.PageTitle}"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="Flick.Text.ClipTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.ClipTitle}"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="Flick.Text.Section" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Section}"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Flick.Text.Body" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Base}"/>
    <Style x:Key="Flick.Text.Control" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Control}"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="Flick.Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Flick.Font.Caption}"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextSecondary}"/>
    </Style>
    <Style x:Key="Flick.Text.Muted" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.TextMuted}"/>
    </Style>
    <!-- A true, centered circular logo, rasterized from the canonical vector.
         No shifted rectangle or second circular mask: the corners of the image
         are already transparent. Navbar, Settings and toast share this source. -->
    <DrawingImage x:Key="Flick.Image.BrandMark.Source">
        <DrawingImage.Drawing>
            <ImageDrawing ImageSource="pack://application:,,,/Flick;component/Assets/Brand/FlickLogo.png"
                          Rect="0,0,38,38"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <Style x:Key="Flick.Image.BrandMark" TargetType="{x:Type Image}">
        <Setter Property="Source" Value="{StaticResource Flick.Image.BrandMark.Source}"/>
        <Setter Property="Width" Value="{StaticResource Flick.Size.ToastLogo}"/>
        <Setter Property="Height" Value="{StaticResource Flick.Size.ToastLogo}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
    </Style>
    <Style x:Key="Flick.Icon.Line" TargetType="{x:Type Path}">
        <Setter Property="Stroke" Value="{DynamicResource Flick.Brush.TextSecondary}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>
</ResourceDictionary>
