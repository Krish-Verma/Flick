                                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Flick.Input.Combo}"><Style.Triggers><DataTrigger Binding="{Binding IsExporting}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                        <ComboBox.ItemTemplate><DataTemplate><StackPanel MaxWidth="420"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Flick.Text.Caption}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Recent exports" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False">
