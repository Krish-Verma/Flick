                                <ProgressBar x:Name="ShareExportProgress" Height="4" Margin="0,4,0,0" IsIndeterminate="True" Foreground="{DynamicResource Flick.Brush.Accent}" Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Local MP4 export activity"/>
                                <Grid x:Name="ShareStatusRow" Margin="0,4,0,0">
