                                            <Setter Property="Background" Value="{DynamicResource Flick.Brush.ShareSurface}"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="12,8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                    <Button DockPanel.Dock="Right" x:Name="CloseEditorTool" Content="Close" Click="CloseEditorTool_Click" HorizontalAlignment="Right" Style="{StaticResource Flick.Button.Ghost}" MinHeight="32" Margin="0"/>
                                    <Button DockPanel.Dock="Right" x:Name="ShareMoreButton" Content="More" Click="ShareMoreButton_Click" Style="{StaticResource Flick.Button.Ghost}" MinHeight="32" MinWidth="60" Padding="8,0" Margin="0,0,4,0" Visibility="{Binding Visibility, ElementName=SharePanel}" ToolTip="Optional direct posting" AutomationProperties.Name="More sharing options">
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="ShareMoreMenu" IsOpen="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
