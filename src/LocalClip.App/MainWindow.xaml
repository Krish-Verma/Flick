<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:LocalClip.App.Views.Components" xmlns:services="clr-namespace:LocalClip.App.Services" x:Class="LocalClip.App.MainWindow" Title="Flick — Gameplay Clipper" Height="760" Width="1240" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterScreen" Background="{DynamicResource Flick.Brush.Canvas}" Foreground="{DynamicResource Flick.Brush.TextPrimary}" FontFamily="{StaticResource Flick.Font.UI}" UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="Window_Closing">
    <Window.Resources>
        <!-- No mismatched one-off control typography: use the same foundation
             from Slice 1 for unstyled legacy controls and new shell views. -->
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Base}"/>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource Flick.Input.Text}"/>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Flick.Button.Secondary}"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <services:WidthToVideoHeightConverter x:Key="Flick.VideoAspectHeight"/>
        <services:ThumbnailImageConverter x:Key="Flick.ThumbnailDecoder"/>
        <services:ShareAspectLabelConverter x:Key="Flick.ShareAspectLabel"/>
        <DataTemplate x:Key="GameFilterLabel">
            <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Flick.Text.Control}">
                <Setter Property="Text" Value="{Binding}"/>
                <Style.Triggers><DataTrigger Binding="{Binding}" Value="All Games"><Setter Property="Text" Value="All games"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style></TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="LibrarySortLabel">
            <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Flick.Text.Control}">
                <Setter Property="Text" Value="{Binding}"/>
                <Style.Triggers><DataTrigger Binding="{Binding}" Value="Recently Exported"><Setter Property="Text" Value="Recently exported"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style></TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Grid x:Name="MainInteractionSurface">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Flick.GridLength.NavRail}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Flick.GridLength.CaptureBar}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Single slim navigation rail; Settings opens existing preferences
             until the dedicated settings layout is implemented in Slice 5. -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource Flick.Brush.Surface}" BorderBrush="{DynamicResource Flick.Brush.Divider}" BorderThickness="0,0,1,0" Padding="11,14">
            <DockPanel LastChildFill="False">
                <Image DockPanel.Dock="Top" Style="{StaticResource Flick.Image.BrandMark}" Width="38" Height="38" Margin="0,0,0,21" ToolTip="Flick — Your Clips"/>
                <Button DockPanel.Dock="Top" x:Name="BtnNavClips" Style="{StaticResource Flick.Button.Icon}" Click="BtnNavClips_Click" AutomationProperties.Name="Your Clips" Background="{DynamicResource Flick.Brush.Raised}" BorderBrush="Transparent" ToolTip="Your Clips">
                    <Path Data="{StaticResource Flick.Icon.Geometry.Library}">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource Flick.Icon.Symbol}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=WorkspacePageLayer}" Value="Collapsed">
                                        <Setter Property="Stroke" Value="{DynamicResource Flick.Brush.BrandAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button DockPanel.Dock="Bottom" x:Name="BtnNavSettings" Style="{StaticResource Flick.Button.Icon}" Click="BtnSettings_Click" AutomationProperties.Name="Settings" ToolTip="Settings">
                    <Path Style="{StaticResource Flick.Icon.Symbol}" Data="{StaticResource Flick.Icon.Geometry.Settings}"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- Capture bar always visible. One dominant action for the active state. -->
        <Border x:Name="CaptureCommandBar" Grid.Row="0" Grid.Column="1" Background="{DynamicResource Flick.Brush.Frosted}" BorderBrush="{DynamicResource Flick.Brush.Divider}" BorderThickness="0,0,0,1" Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CaptureSourceColumn" Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Capture source" Style="{StaticResource Flick.Text.Caption}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <Grid><ComboBox x:Name="CmbTargets" AutomationProperties.Name="Capture source" AutomationProperties.HelpText="{Binding CaptureSourceCaption}" MinWidth="0" Width="235" Height="32" DisplayMemberPath="DisplayName" ToolTip="Choose a window or monitor. Display capture can include notifications." IsEnabled="{Binding CanChangeCaptureSource}" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" >
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Flick.Input.Combo}"><Style.Triggers><DataTrigger Binding="{Binding IsAutomaticGameCapture}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                    </ComboBox><TextBlock Text="{Binding AutomaticGameSourceText}" TextTrimming="CharacterEllipsis" MaxWidth="235" Height="32" VerticalAlignment="Center" ToolTip="Automatic game replay. Stop Replay to return to your manual capture source.">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Flick.Text.Control}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAutomaticGameCapture}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock></Grid>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Flick.Button.Icon}" Click="BtnRefreshTargets_Click" AutomationProperties.Name="Refresh Capture Sources" ToolTip="Refresh Capture Sources" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource Flick.Icon.Symbol}" Data="{StaticResource Flick.Icon.Geometry.Refresh}" Width="16" Height="16"/>
                </Button>
                <Button x:Name="BtnRecordingHealth" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,14,0" MinWidth="0" Padding="0" Style="{StaticResource Flick.Button.Ghost}" Click="BtnRecordingHealth_Click" AutomationProperties.Name="Recording health and recent errors" ToolTip="Recording health · source, shortcuts and recent errors">
                <StackPanel>
                    <Border x:Name="StatusBadge" Background="{DynamicResource Flick.Brush.Raised}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CaptureStateDot" Width="7" Height="7" Fill="{DynamicResource Flick.Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TxtCaptureStatus" Text="Replay off" Style="{StaticResource Flick.Text.Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TxtBufferedDuration" Text="{Binding BufferedDurationText}" Style="{StaticResource Flick.Text.Numeric}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                </Button>
                <Button Grid.Column="3" x:Name="BtnToggleCapture" Click="BtnToggleCapture_Click" AutomationProperties.Name="Toggle Replay" Style="{StaticResource Flick.Button.Primary}" Content="Start replay" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Grid.Column="4" x:Name="BtnSaveReplay" Click="BtnSaveReplay_Click" AutomationProperties.Name="Save Last Replay" Style="{StaticResource Flick.Button.Secondary}" Content="Save last 30 seconds" IsEnabled="False" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Body: Gallery & Editor -->
        <Grid x:Name="WorkspaceContentGrid" Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ClipLibraryColumn" Width="286" MinWidth="0"/> <!-- Library / compact -->
                <ColumnDefinition x:Name="LibrarySplitterColumn" Width="4"/> <!-- Only split mode -->
                <ColumnDefinition x:Name="ClipEditorColumn" Width="*"/> <!-- Editor / compact -->
            </Grid.ColumnDefinitions>

            <!-- Left: Clip Gallery -->
            <Border x:Name="ClipLibraryPanel" Grid.Column="0" Background="{DynamicResource Flick.Brush.Surface}" BorderBrush="{DynamicResource Flick.Brush.Divider}" BorderThickness="0,0,1,0">
                <Grid x:Name="LibraryLayoutRoot" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="96"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Compact library header, search and local source filters. -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Your clips" Style="{StaticResource Flick.Text.Section}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Import folder" ContentTemplate="{StaticResource Flick.IconText.Add}" Style="{StaticResource Flick.Button.Secondary}" FontSize="12" Padding="9,0" MinWidth="0" MinHeight="32" Click="BtnImportFolder_Click" ToolTip="Link clips already saved by other recording software"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="TxtClipSearch" AutomationProperties.Name="Search clips" AutomationProperties.HelpText="Search titles, games and tags. Ctrl+F focuses search." Style="{StaticResource Flick.Input.Text}" Padding="10,0,52,0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=180}" ToolTip="Search titles, games, source names and tags; use #tag"/>
                            <Button x:Name="BtnClearClipSearch" Content="Clear" Click="ClearClipSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="44" FontSize="13" MinHeight="32" Padding="4,0" Margin="0,0,2,0" AutomationProperties.Name="Clear clip search" Visibility="{Binding LibraryHasSearch, Converter={StaticResource BoolToVis}}" Style="{StaticResource Flick.Button.Ghost}"/>
                            <TextBlock Text="Search clips…" Foreground="{DynamicResource Flick.Brush.TextSecondary}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BtnLibraryFilters" DockPanel.Dock="Right" Content="{Binding LibraryFilterLabel}" Tag="Filters" Click="LibraryPanel_Click" Style="{StaticResource Flick.Button.Ghost}" MinHeight="30" Padding="6,0" Margin="4,0,0,0" AutomationProperties.Name="Clip filters" ToolTip="Filter clips or reset active filters"/>
                        <Border Style="{StaticResource Flick.Library.FilterTrack}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioAllClips" Content="All clips" Style="{StaticResource Flick.Library.FilterChip}" GroupName="LibrarySources" Checked="LibraryFilter_Checked"/>
                                <RadioButton x:Name="RadioFlickClips" Content="Flick" Style="{StaticResource Flick.Library.FilterChip}" GroupName="LibrarySources" Checked="LibraryFilter_Checked"/>
                                <RadioButton x:Name="RadioImportedClips" Content="Imported" Style="{StaticResource Flick.Library.FilterChip}" GroupName="LibrarySources" Checked="LibraryFilter_Checked"/>
                            </StackPanel>
                        </Border>
                        </DockPanel>

                    </StackPanel>

                    <!-- Virtualized clip rows; imported media stays in place. -->
                    <Grid Grid.Row="1" MinHeight="0">
                        <ListBox x:Name="ClipList" AutomationProperties.Name="Your clips" ItemsSource="{Binding FilteredClips}" SelectedItem="{Binding SelectedClip, Mode=TwoWay}" Style="{StaticResource Flick.Library.List}" PreviewMouseRightButtonDown="ClipList_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Toggle favorite" Click="ToggleFavorite_Click"/>
                                    <MenuItem Header="Rename clip" Click="BtnRename_Click"/>
                                    <MenuItem Header="Open original folder" Click="BtnOpenMediaFolder_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Remove or delete clip…" Click="BtnDelete_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource Flick.Library.Item}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                    <TextBlock Text="{Binding GameGroup}" Margin="7,10,0,2" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Flick.Text.Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowGameHeading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <Grid Height="62" Margin="7,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="80" Height="45" Background="{DynamicResource Flick.Brush.Raised}" CornerRadius="7" ClipToBounds="True" VerticalAlignment="Center">
                                            <Grid>
                                                <Path Style="{StaticResource Flick.Icon.Symbol}" Data="{StaticResource Flick.Icon.Geometry.Original}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False"/>
                                                <Image services:AsyncThumbnail.Path="{Binding ThumbnailPath}" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" MinWidth="0">
                                            <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource Flick.Text.Control}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DisplayTitle}"/>
                                            <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" ToolTip="{Binding TagsText}">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Flick.Text.Caption}">
                                                    <Setter Property="Text" Value="{Binding OrganizationSummary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OrganizationSummary}" Value="Ungrouped"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding OrganizationSummary}" Value="Favorite · Ungrouped"><Setter Property="Text" Value="Favorite"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                            <DockPanel Margin="0,3,0,0" LastChildFill="False">
                                                <TextBlock Style="{StaticResource Flick.Text.Numeric}" ToolTip="{Binding CreatedAt, StringFormat={}{0:f}}">
                                                    <TextBlock.Text><MultiBinding StringFormat="{}{0} · {1:MMM d}"><Binding Path="FormattedDuration"/><Binding Path="CreatedAt"/></MultiBinding></TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding LibraryStatusForUi}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Flick.Text.Caption}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LibraryStatusForUi}" Value="Flick"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding LibraryStatusForUi}" Value="Offline">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.Warning}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="LibraryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" Visibility="{Binding LibraryIsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LibraryEmptyTitle}" Style="{StaticResource Flick.Text.Control}" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{Binding LibraryEmptyHint}" Style="{StaticResource Flick.Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,8"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="Clear search" Click="ClearClipSearch_Click" Style="{StaticResource Flick.Button.Secondary}" Margin="3" Visibility="{Binding LibraryHasSearch, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Reset filters" Click="ClearLibraryFilters_Click" Style="{StaticResource Flick.Button.Secondary}" Margin="3" Visibility="{Binding LibraryHasFilters, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>
                            <Button Content="Choose source" Click="ChooseCaptureSource_Click" HorizontalAlignment="Center">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Flick.Button.Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LibraryHasClips}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">

                        <TextBlock Text="{Binding LibrarySummaryText}" Style="{StaticResource Flick.Text.Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnLibraryDetails" Grid.Column="0" Content="Details" Tag="Details" Click="LibraryPanel_Click" IsEnabled="{Binding CanOrganizeClip}" Style="{StaticResource Flick.Button.Ghost}" HorizontalAlignment="Left" MinHeight="32" MinWidth="0" Padding="8,0" AutomationProperties.Name="Clip details"/>
                            <Button Grid.Column="1" Content="Open folder" Click="BtnOpenMediaFolder_Click" Style="{StaticResource Flick.Button.Ghost}" HorizontalAlignment="Left" MinHeight="32" MinWidth="0" Padding="9,0"/>
                            <Button Grid.Column="2" Content="Rescan" Click="BtnRescan_Click" Style="{StaticResource Flick.Button.Ghost}" HorizontalAlignment="Right" MinHeight="32" MinWidth="0" Padding="9,0"/>
                        </Grid>
                    </StackPanel>
                    <Border x:Name="LibraryFiltersPanel" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="5" VerticalAlignment="Top" Visibility="Collapsed" Background="{DynamicResource Flick.Brush.Surface}" BorderBrush="{DynamicResource Flick.Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Flick.Corner.Panel}" Padding="12" KeyboardNavigation.TabNavigation="Cycle">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnCloseLibraryFiltersPanel" DockPanel.Dock="Right" Content="Close" Click="CloseLibraryPanel_Click" Style="{StaticResource Flick.Button.Ghost}" MinHeight="32" Padding="8,0" AutomationProperties.Name="Close filters"/>
                                <Button DockPanel.Dock="Right" Content="Reset" Click="ClearLibraryFilters_Click" Style="{StaticResource Flick.Button.Ghost}" MinHeight="32" Padding="8,0" AutomationProperties.Name="Reset clip filters" Visibility="{Binding LibraryHasFilters, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Filters" Style="{StaticResource Flick.Text.Section}" VerticalAlignment="Center"/>
                            </DockPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Game" Style="{StaticResource Flick.Text.Caption}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding GameGroups}" SelectedItem="{Binding GameFilter}" ItemTemplate="{StaticResource GameFilterLabel}" MinWidth="0" Style="{StaticResource Flick.Input.Combo}" AutomationProperties.Name="Filter by game"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Sort" Style="{StaticResource Flick.Text.Caption}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding LibrarySortChoices}" SelectedItem="{Binding LibrarySort}" ItemTemplate="{StaticResource LibrarySortLabel}" MinWidth="0" Style="{StaticResource Flick.Input.Combo}" AutomationProperties.Name="Sort clips"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <CheckBox Content="Favorites only" IsChecked="{Binding FavoritesOnly}" Style="{StaticResource Flick.Input.CheckBox}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LibraryPeriodChoices}" SelectedItem="{Binding LibraryPeriod}" MinWidth="0" Style="{StaticResource Flick.Input.Combo}" AutomationProperties.Name="Filter Clip Date"/>
                        </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="LibraryDetailsPanel" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="5" VerticalAlignment="Top" Visibility="Collapsed" Background="{DynamicResource Flick.Brush.Surface}" BorderBrush="{DynamicResource Flick.Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Flick.Corner.Panel}" Padding="12" KeyboardNavigation.TabNavigation="Cycle">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnCloseLibraryDetailsPanel" DockPanel.Dock="Right" Content="Close" Click="CloseLibraryPanel_Click" Style="{StaticResource Flick.Button.Ghost}" MinHeight="32" Padding="8,0" AutomationProperties.Name="Close clip details"/>
                                <TextBlock Text="Clip details" Style="{StaticResource Flick.Text.Section}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Game label" Style="{StaticResource Flick.Text.Caption}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding GameDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Flick.Input.Text}" MaxLength="80" AutomationProperties.Name="Clip Game Label"/>
                                <TextBlock Text="Tags · comma separated" Style="{StaticResource Flick.Text.Caption}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding TagsDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Flick.Input.Text}" MaxLength="400" AutomationProperties.Name="Clip tags"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="BtnSaveClipDetails" Content="Save details" Click="SaveOrganization_Click" IsEnabled="{Binding HasUnsavedOrganization}" Style="{StaticResource Flick.Button.Secondary}" Padding="9,0" Margin="0,0,8,0"/>
                                    <Button Content="Favorite" Click="ToggleFavorite_Click" Style="{StaticResource Flick.Button.Ghost}" Padding="9,0"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtClipDetailsState" Text="{Binding EditorSaveState}" Style="{StaticResource Flick.Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding EditorSaveState}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter x:Name="LibrarySplitter" Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" HorizontalAlignment="Stretch" ToolTip="Resize clip library">
                <GridSplitter.Style>
                    <Style TargetType="{x:Type GridSplitter}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="services:FlickHoverFeedback.Enabled" Value="True"/>
                        <Setter Property="Template"><Setter.Value>
                            <ControlTemplate TargetType="{x:Type GridSplitter}">
                                <Border Background="{TemplateBinding Background}">
                                    <Border x:Name="PART_FlickHoverSurface" Background="White" Opacity="0" IsHitTestVisible="False"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value></Setter>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Flick.Brush.Focus}"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- Scrollable editor and sticky share dock; compact mode fills entire workspace. -->
            <Grid x:Name="ClipEditorPanel" Grid.Column="2" Margin="12,10,12,12" Background="{DynamicResource Flick.Brush.Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid x:Name="EditorClipHeader" Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" MinWidth="0" VerticalAlignment="Center">
                                <Button x:Name="BtnBackToLibrary" Content="Your clips" ContentTemplate="{StaticResource Flick.IconText.Back}" Style="{StaticResource Flick.Button.Ghost}" HorizontalAlignment="Left" Margin="0,0,0,6" Click="BtnBackToLibrary_Click" Visibility="Collapsed" ToolTip="Return to Your Clips" AutomationProperties.Name="Back to Your Clips"/>
                                <TextBlock Text="{Binding SelectedClip.DisplayTitle, TargetNullValue=Select a clip}" Style="{StaticResource Flick.Text.ClipTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SelectedClip.LibrarySource, FallbackValue=Your library}" Style="{StaticResource Flick.Text.Caption}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="  ·  " Style="{StaticResource Flick.Text.Caption}"/>
                                    <TextBlock Text="{Binding SelectedClip.FormattedDuration, FallbackValue=0:00}" Style="{StaticResource Flick.Text.Caption}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnClipActions" Style="{StaticResource Flick.Button.Icon}" Click="BtnClipActions_Click" ToolTip="Clip Actions" AutomationProperties.Name="Clip Actions" Margin="10,0,0,0">
                                <Path Style="{StaticResource Flick.Icon.Symbol}" Data="{StaticResource Flick.Icon.Geometry.More}" Width="16" Height="16"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename clip" Click="BtnRename_Click"/>
                                        <MenuItem Header="Open original folder" Click="BtnOpenMediaFolder_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Remove or delete clip…" Click="BtnDelete_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid><Border Grid.Row="1" MinHeight="80" Background="{DynamicResource Flick.Brush.Canvas}" BorderBrush="{DynamicResource Flick.Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Flick.Corner.Panel}" ClipToBounds="True" Margin="0,0,0,6" VerticalAlignment="Stretch" x:Name="PreviewSurface" SizeChanged="PreviewSurface_SizeChanged">
