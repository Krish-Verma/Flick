                            <Button x:Name="ToolOriginal" Tag="Original" Click="EditorTool_Click" Style="{StaticResource Flick.Button.Ghost}" MinHeight="52" Padding="8,4" Margin="6,0" ToolTip="Original" AutomationProperties.Name="Original" IsEnabled="{Binding CanEditClip}">
                                <StackPanel>
                                    <Path Data="{StaticResource Flick.Icon.Geometry.Original}" Width="20" Height="20">
                                        <Path.Style>
                                            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource Flick.Icon.Tool}">
