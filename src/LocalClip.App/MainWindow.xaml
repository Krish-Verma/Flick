                                <StackPanel>
                                    <Path Style="{StaticResource Flick.Icon.Tool}" Data="{StaticResource Flick.Icon.Geometry.Trim}" Width="20" Height="20"/>
                                    <TextBlock Text="Trim" Style="{StaticResource Flick.Text.Caption}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ToolAudio" Tag="Audio" Click="EditorTool_Click" Style="{StaticResource Flick.Button.Ghost}" MinHeight="52" Padding="8,4" Margin="6,0" ToolTip="Audio" AutomationProperties.Name="Audio" IsEnabled="{Binding CanEditClip}">
                                <StackPanel>
                                    <Path Style="{StaticResource Flick.Icon.Tool}" Data="{StaticResource Flick.Icon.Geometry.Audio}" Width="20" Height="20"/>
