                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Tag="{Binding}" Click="SeekFrame_Click" Style="{StaticResource Flick.Button.Ghost}" Padding="3" Margin="0,0,6,6">
                                                <StackPanel><Image Source="{Binding Image}" Width="96" Height="54" Stretch="Uniform"/><TextBlock Text="{Binding Label}" Style="{StaticResource Flick.Text.Caption}" HorizontalAlignment="Center"/></StackPanel>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding FilmstripStatusText}" Style="{StaticResource Flick.Text.Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="Keyboard shortcuts" ToolTip="Left/Right: seek · Ctrl+Left/Right: 5s · Home/End · I/O: trim · M: marker · Ctrl+Z: undo trim. Inactive while typing." Style="{StaticResource Flick.Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border><Border Background="Transparent" BorderThickness="0" Padding="6,3" x:Name="AudioPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <Expander x:Name="AudioExpander" Style="{StaticResource Flick.Expander.Disclosure}" IsEnabled="{Binding CanEditClip}" Header="Export audio" ToolTip="The original stays unchanged. Combined is a complete alternate mix and excludes the dedicated tracks." IsExpanded="False" Foreground="{DynamicResource Flick.Brush.TextPrimary}" Background="Transparent" Padding="4">
                                <StackPanel Margin="5,8,5,8">
                                    <ItemsControl ItemsSource="{Binding SelectedClip.AudioTracks}">
