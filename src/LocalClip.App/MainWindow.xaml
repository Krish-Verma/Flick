<Window x:Class="LocalClip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flick — Gameplay Clipper" Height="760" Width="1240" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Flick.Brush.Canvas}" Foreground="{DynamicResource Flick.Brush.TextPrimary}"
        FontFamily="{StaticResource Flick.Font.UI}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#454052"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#242436"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Flick.Size.NavRail}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Flick.Size.CaptureBar}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Single slim navigation rail; Settings opens existing preferences
             until the dedicated settings layout is implemented in Slice 5. -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource Flick.Brush.Surface}"
                BorderBrush="{DynamicResource Flick.Brush.Border}" BorderThickness="0,0,1,0"
                Padding="11,14">
            <DockPanel LastChildFill="False">
                <Image DockPanel.Dock="Top" Style="{StaticResource Flick.Image.BrandMark}"
                       Width="38" Height="38" Margin="0,0,0,21"
                       ToolTip="Flick — Your Clips"/>
                <Button DockPanel.Dock="Top" x:Name="BtnNavClips"
                        Style="{StaticResource Flick.Button.Icon}" Click="BtnNavClips_Click"
                        Background="#33283F" BorderBrush="{DynamicResource Flick.Brush.BorderStrong}"
                        ToolTip="Your Clips">
                    <Path Data="M 3,5 L 21,5 L 21,19 L 3,19 Z M 8,5 L 8,19 M 16,5 L 16,19 M 3,10 L 8,10 M 16,10 L 21,10"
                          Stroke="{DynamicResource Flick.Brush.Accent}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="19" Height="19" Stretch="Uniform"/>
                </Button>
                <Button DockPanel.Dock="Bottom" x:Name="BtnNavSettings"
                        Style="{StaticResource Flick.Button.Icon}" Click="BtnSettings_Click"
                        ToolTip="Settings">
                    <Path Data="M 3,7 L 21,7 M 3,17 L 21,17 M 9,3 L 9,11 M 15,13 L 15,21"
                          Stroke="{DynamicResource Flick.Brush.TextSecondary}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="19" Height="19" Stretch="Uniform"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- Capture bar always visible. One dominant action for the active state. -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Flick.Brush.Frosted}"
                BorderBrush="{DynamicResource Flick.Brush.Border}" BorderThickness="0,0,0,1"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Capture Source" Style="{StaticResource Flick.Text.Caption}"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbTargets" Style="{StaticResource Flick.Input.Combo}"
                              MinWidth="0" Width="235" Height="32"
                              DisplayMemberPath="DisplayName"
                              ToolTip="Choose a window or monitor. Display capture can include notifications."
                              ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻"
                        Style="{StaticResource Flick.Button.Icon}"
                        Click="BtnRefreshTargets_Click" ToolTip="Refresh Capture Sources"
                        Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,0,14,0" MinWidth="0">
                    <Border x:Name="StatusBadge" CornerRadius="{StaticResource Flick.Corner.Pill}"
                            Background="#30283B" Padding="9,4" HorizontalAlignment="Left"
                            Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CaptureStateDot" Width="7" Height="7"
                                     Fill="{DynamicResource Flick.Brush.TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TxtCaptureStatus" Text="Replay Off"
                                       Style="{StaticResource Flick.Text.Control}" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TxtBufferedDuration" Text="{Binding BufferedDurationText}"
                               Style="{StaticResource Flick.Text.Muted}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <Button Grid.Column="3" x:Name="BtnToggleCapture"
                        Click="BtnToggleCapture_Click"
                        Style="{StaticResource Flick.Button.Primary}"
                        Content="Start Replay" Margin="0,0,8,0"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="4" x:Name="BtnSaveReplay"
                        Click="BtnSaveReplay_Click"
                        Style="{StaticResource Flick.Button.Secondary}"
                        Content="Save Last 30 Seconds" IsEnabled="False"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Body: Gallery & Editor -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" MinWidth="255" MaxWidth="430"/> <!-- Gallery -->
                <ColumnDefinition Width="4"/>                                  <!-- Splitter -->
                <ColumnDefinition Width="*"/>                                  <!-- Editor / Share -->
            </Grid.ColumnDefinitions>

            <!-- Left: Clip Gallery -->
            <Border Grid.Column="0" Background="#11121D" BorderBrush="#242436" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Compact library header, search and local source filters. -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Your Clips"
                                       Style="{StaticResource Flick.Text.Section}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="+ Import Folder"
                                    Style="{StaticResource Flick.Button.Secondary}"
                                    FontSize="12" Padding="9,0" MinWidth="0" MinHeight="32"
                                    Click="BtnImportFolder_Click"
                                    ToolTip="Link clips already saved by other recording software"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="TxtClipSearch" Style="{StaticResource Flick.Input.Text}"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search clip titles and local source names"/>
                            <TextBlock Text="Search Clips…" Foreground="{DynamicResource Flick.Brush.TextMuted}"
                                       Margin="11,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <RadioButton x:Name="RadioAllClips" Content="All Clips"
                                         Style="{StaticResource Flick.Library.FilterChip}"
                                         GroupName="LibrarySources"
                                         Checked="LibraryFilter_Checked" Margin="0,0,5,0"/>
                            <RadioButton x:Name="RadioFlickClips" Content="Flick"
                                         Style="{StaticResource Flick.Library.FilterChip}"
                                         GroupName="LibrarySources"
                                         Checked="LibraryFilter_Checked" Margin="0,0,5,0"/>
                            <RadioButton x:Name="RadioImportedClips" Content="Imported"
                                         Style="{StaticResource Flick.Library.FilterChip}"
                                         GroupName="LibrarySources"
                                         Checked="LibraryFilter_Checked"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Virtualized clip rows; imported media stays in place. -->
                    <Grid Grid.Row="1" MinHeight="0">
                        <ListBox x:Name="ClipList"
                                 ItemsSource="{Binding FilteredClips}"
                                 SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                                 Style="{StaticResource Flick.Library.List}"
                                 PreviewMouseRightButtonDown="ClipList_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename Clip" Click="BtnRename_Click"/>
                                    <MenuItem Header="Open Original Folder" Click="BtnOpenMediaFolder_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Remove or Delete Clip…" Click="BtnDelete_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource Flick.Library.Item}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="62" Margin="7,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="74" Height="48"
                                                Background="{DynamicResource Flick.Brush.Raised}"
                                                CornerRadius="7" ClipToBounds="True"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding ThumbnailPath}"
                                                   Stretch="UniformToFill"
                                                   SnapsToDevicePixels="True"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0"
                                                    VerticalAlignment="Center" MinWidth="0">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource Flick.Text.Control}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding Title}"/>
                                            <TextBlock Text="{Binding LibrarySource}"
                                                       Style="{StaticResource Flick.Text.Caption}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Margin="0,2,0,0"/>
                                            <DockPanel Margin="0,3,0,0" LastChildFill="False">
                                                <TextBlock Text="{Binding FormattedDuration}"
                                                           Style="{StaticResource Flick.Text.Caption}"
                                                           Foreground="{DynamicResource Flick.Brush.Accent}"/>
                                                <TextBlock Text="{Binding LibraryStatus}"
                                                           Style="{StaticResource Flick.Text.Caption}"
                                                           HorizontalAlignment="Right"
                                                           DockPanel.Dock="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource Flick.Text.Caption}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.Warning}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No Clips Found. Save a Replay or Import a Folder."
                                   Style="{StaticResource Flick.Text.Caption}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Margin="20" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource Flick.Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredClips.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding LibrarySummaryText}"
                                   Style="{StaticResource Flick.Text.Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Open Folder"
                                    Click="BtnOpenMediaFolder_Click"
                                    Style="{StaticResource Flick.Button.Ghost}"
                                    HorizontalAlignment="Left" MinHeight="32"
                                    MinWidth="0" Padding="9,0"/>
                            <Button Grid.Column="1" Content="Rescan"
                                    Click="BtnRescan_Click"
                                    Style="{StaticResource Flick.Button.Ghost}"
                                    HorizontalAlignment="Right" MinHeight="32"
                                    MinWidth="0" Padding="9,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="#151622" HorizontalAlignment="Stretch"/>

            <!-- Right: Editor, Trim, Audio, & Discord Share -->
            <Grid Grid.Column="2" Margin="16" Background="#0B0B14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Actions -->
                    <RowDefinition Height="2*"/>   <!-- Player -->
                    <RowDefinition Height="Auto"/> <!-- Player Scrubber -->
                    <RowDefinition Height="Auto"/> <!-- Trim Controls -->
                    <RowDefinition Height="Auto"/> <!-- Audio Mix Controls -->
                    <RowDefinition Height="Auto"/> <!-- Discord Export & Share -->
                </Grid.RowDefinitions>

                <!-- Selected Clip Title & Delete/Rename -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedClip.Title, FallbackValue='No Clip Selected'}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedClip.FormattedDuration, StringFormat=' ({0})'}" FontSize="14" Foreground="#C69BFF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Rename" Click="BtnRename_Click" Margin="0,0,8,0" Background="#242436"/>
                        <Button Content="{Binding SelectedClip.LibraryDeleteAction, FallbackValue=Delete}" Click="BtnDelete_Click" Background="#7F1D1D" Foreground="#FCA5A5"/>
                    </StackPanel>
                </DockPanel>

                <!-- Video Player -->
                <Border Grid.Row="1" Background="#000000" CornerRadius="6" ClipToBounds="True">
                    <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  ScrubbingEnabled="True" Stretch="Uniform"
                                  MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded" MediaFailed="VideoPlayer_MediaFailed"/>
                </Border>

                <!-- Player Transport Controls -->
                <Grid Grid.Row="2" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0"><Button x:Name="BtnPlayPause" Content="▶ Play" Click="BtnPlayPause_Click" Width="80" Margin="0,0,10,0"/><Button Content="Original" Click="PreviewOriginal_Click" Margin="0,0,8,0"/><Button Content="Export MP4" Click="PreviewExport_Click" Margin="0,0,8,0"/><Button Content="Open Player" Click="OpenInPlayer_Click" Margin="0,0,10,0"/></StackPanel>
                    <Slider x:Name="PlayerSlider" Grid.Column="1" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                            ValueChanged="PlayerSlider_ValueChanged" PreviewMouseLeftButtonDown="PlayerSlider_MouseDown" PreviewMouseLeftButtonUp="PlayerSlider_MouseUp"/>
                    <TextBlock x:Name="TxtPlayerTime" Grid.Column="2" Text="0:00 / 0:00" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#B9B3CC"/>
                </Grid>

                <!-- Trim Controls -->
                <Border Grid.Row="3" Background="#151622" BorderBrush="#242436" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Trim Start:" VerticalAlignment="Center" Grid.Row="0"/>
                        <Slider x:Name="SliderTrimStart" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="0" Value="{Binding SelectedClip.TrimStartSeconds, Mode=TwoWay}"
                                ValueChanged="TrimSliders_ValueChanged"/>
                        <TextBlock x:Name="TxtTrimStart" Grid.Row="0" Grid.Column="2" Text="{Binding SelectedClip.TrimStartSeconds, StringFormat='{}{0:F1}s'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Text="Trim End:" VerticalAlignment="Center" Grid.Row="1" Margin="0,8,0,0"/>
                        <Slider x:Name="SliderTrimEnd" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,8,0,0"
                                Minimum="0" Value="{Binding SelectedClip.TrimEndSeconds, Mode=TwoWay}"
                                ValueChanged="TrimSliders_ValueChanged"/>
                        <TextBlock x:Name="TxtTrimEnd" Grid.Row="1" Grid.Column="2" Text="{Binding SelectedClip.TrimEndSeconds, StringFormat='{}{0:F1}s'}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Audio Mixer Controls -->
                <Border Grid.Row="4" Background="#151622" BorderBrush="#242436" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Export audio tracks (mute &amp; gain)" FontWeight="SemiBold" Foreground="#C69BFF" Margin="0,0,0,6"/>
                        <TextBlock Text="Adjust levels, export, then preview MP4 to hear the mix." Foreground="#B9B3CC" FontSize="11" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding SelectedClip.AudioTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <CheckBox Grid.Column="1" Content="Mute" IsChecked="{Binding IsMuted, Mode=TwoWay}" Click="AudioMuteChanged" VerticalAlignment="Center" Foreground="#EF4444"/>
                                        <Slider Grid.Column="2" Minimum="0" Maximum="2.0" Value="{Binding Gain, Mode=TwoWay}" ValueChanged="AudioGainChanged" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Gain, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B9B3CC"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Discord Export & Share Actions -->
                <Border Grid.Row="5" Background="#201B2B" BorderBrush="#8D60B8" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <!-- Presets & Export Button -->
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Discord Target:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="Radio20" Content="20 MB" GroupName="Cap" Click="Preset20_Click" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FAFAFA"/>
                                <RadioButton x:Name="Radio50" Content="50 MB" GroupName="Cap" Click="Preset50_Click" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FAFAFA"/>
                                <RadioButton x:Name="Radio100" Content="100 MB" GroupName="Cap" Click="Preset100_Click" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FAFAFA"/>
                                <RadioButton x:Name="RadioCustom" Content="Custom" GroupName="Cap" Click="PresetCustom_Click" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#FAFAFA"/>
                                <TextBox x:Name="TxtCustomMb" Width="46" Text="20" VerticalAlignment="Center" LostFocus="TxtCustomMb_LostFocus" ToolTip="Custom target in MB (1–250)"/>
                                <TextBlock Text="MB" Foreground="#B9B3CC" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>

                            <Button Content="⚡ Export for Discord" Click="BtnExport_Click"
                                    Background="#7953A8" FontWeight="Bold" Padding="16,8" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Progress Bar (while exporting) -->
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ExportProgress}"
                                     Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>

                        <!-- Status text -->
                        <TextBlock Text="{Binding ExportStatusMessage}" Foreground="#CDB1FF" FontSize="12" Margin="0,0,0,10"/>

                        <!-- Ready Share Actions (Native Drag & Copy into Discord) -->
                        <Border Background="#151622" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="10"
                                Visibility="{Binding IsExportReady, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Drag Handle -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Buttons -->
                                </Grid.ColumnDefinitions>

                                <!-- Drag Handle -->
                                <Border x:Name="DragHandle" Grid.Column="0" Background="#346957" CornerRadius="4" Padding="14,8"
                                        Cursor="Hand" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                                    <TextBlock Text="✋ DRAG TO DISCORD" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="Share file validated and ready!" FontWeight="SemiBold" Foreground="#8FD4B0"/>
                                    <TextBlock Text="{Binding ReadyExportFilePath}" FontSize="11" Foreground="#9C97AD" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📋 Copy File" Click="BtnCopyFile_Click" Margin="0,0,8,0" Background="#242436" ToolTip="Copy MP4 to clipboard (Ctrl+V into Discord)"/>
                                    <Button Content="📁 Open Folder" Click="BtnOpenExportFolder_Click" Margin="0,0,8,0" Background="#242436"/>
                                    <Button Content="🚀 Send to Channel" Click="BtnSendWebhook_Click" Background="#4F46E5" FontWeight="Bold" ToolTip="Send to configured Discord text channel webhook"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Grid.Column="1" Background="#11121D" BorderBrush="#242436" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusDetails}" Foreground="#B9B3CC"
                           FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ResourceStatsText}" Foreground="#9C97AD"
                           FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
