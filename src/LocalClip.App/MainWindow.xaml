                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Flick.Text.Control}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                    <CheckBox Grid.Column="1" Content="Mute" Style="{StaticResource Flick.Input.CheckBox}" IsChecked="{Binding IsMuted, Mode=TwoWay}" VerticalAlignment="Center" Foreground="{DynamicResource Flick.Brush.TextSecondary}" AutomationProperties.Name="{Binding Name, StringFormat=Mute {0}}" AutomationProperties.HelpText="Changes the exported mix; the original stays unchanged."/>
                                                    <Slider Grid.Column="2" Minimum="0" Maximum="2" Style="{StaticResource Flick.Input.Slider}" Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat={}{0} export volume}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Gain, StringFormat='{}{0:P0}'}" Style="{StaticResource Flick.Text.Caption}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel LastChildFill="True" Margin="0,2,0,0">
                                        <Button DockPanel.Dock="Right" Content="Reset mix" Style="{StaticResource Flick.Button.Ghost}" Click="ResetAudioMix_Click" HorizontalAlignment="Right" MinHeight="28"/>
                                        <Button x:Name="BtnAudioMixPreview" Content="Preview mix" Click="BuildAudioMixPreview_Click" Style="{StaticResource Flick.Button.Ghost}" HorizontalAlignment="Left"/>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>
                        </Border></StackPanel></ScrollViewer>
                        <Border Background="Transparent" BorderThickness="0" Padding="0" Margin="0" x:Name="SharePanel" Visibility="Collapsed">
