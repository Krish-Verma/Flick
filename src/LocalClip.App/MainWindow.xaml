                                            <TextBlock x:Name="TxtShareTileState" Text="{Binding ShareTileStateText}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExportStatusMessage}" AutomationProperties.LiveSetting="Polite">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Flick.Text.Control}"><Setter Property="Foreground" Value="{DynamicResource Flick.Brush.Accent}"/><Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShareTileStateText}" Value="Export failed"><Setter Property="Foreground" Value="{DynamicResource Flick.Brush.Danger}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding ShareTileStateText}" Value="Original offline"><Setter Property="Foreground" Value="{DynamicResource Flick.Brush.Warning}"/></DataTrigger>
