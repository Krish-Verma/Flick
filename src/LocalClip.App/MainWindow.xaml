<Window x:Class="LocalClip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flick - Gameplay Clipper" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12" Foreground="#FAFAFA"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar / Controls -->
            <RowDefinition Height="*"/>    <!-- Main Body: Gallery & Editor -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Arm/Disarm & Save -->
                    <ColumnDefinition Width="Auto"/> <!-- Target Selector -->
                    <ColumnDefinition Width="*"/>    <!-- Status & Buffer -->
                    <ColumnDefinition Width="Auto"/> <!-- Resource & Settings -->
                </Grid.ColumnDefinitions>

                <!-- Arm & Save Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button x:Name="BtnToggleCapture" Click="BtnToggleCapture_Click"
                            Padding="16,8" Margin="0,0,8,0" FontWeight="Bold" FontSize="14"
                            Background="#16A34A" Content="ARM REPLAY (Ctrl+Shift+F9)"/>

                    <Button x:Name="BtnSaveReplay" Click="BtnSaveReplay_Click"
                            Padding="16,8" Margin="0,0,16,0" FontWeight="Bold" FontSize="14"
                            Background="#2563EB" Content="SAVE CLIP (Ctrl+Shift+F8)"/>
                </StackPanel>

                <!-- Target Selector -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Target:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbTargets" Width="260" Height="32" VerticalContentAlignment="Center"
                              Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                              ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"/>
                    <Button Content="↻" Click="BtnRefreshTargets_Click" Margin="6,0,0,0" Padding="8,4" ToolTip="Refresh active targets"/>
                    <Border Background="#27272A" CornerRadius="4" Padding="8,4" Margin="10,0,0,0">
                        <TextBlock Text="System Audio + Mic [Fallback]" Foreground="#A1A1AA" FontSize="11" ToolTip="Process loopback fallback mode"/>
                    </Border>
                </StackPanel>

                <!-- Status & Buffer Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,4" Background="#3F3F46" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtCaptureStatus" Text="{Binding CaptureStatus}" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Buffered: " VerticalAlignment="Center" Foreground="#A1A1AA"/>
                    <TextBlock x:Name="TxtBufferedDuration" Text="{Binding BufferedDurationText}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Settings & Stats -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResourceStatsText}" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Settings" Click="BtnSettings_Click" Padding="12,6" Background="#27272A"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Gallery & Editor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="500"/> <!-- Gallery -->
                <ColumnDefinition Width="4"/>                                  <!-- Splitter -->
                <ColumnDefinition Width="*"/>                                  <!-- Editor / Share -->
            </Grid.ColumnDefinitions>

            <!-- Left: Clip Gallery -->
            <Border Grid.Column="0" Background="#141417" BorderBrush="#27272A" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" Background="#1E1E24" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                 ToolTip="Search clips by title or source"/>
                        <TextBlock Text="Search clips..." Foreground="#71717A" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Clip List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredClips}" SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C1C21" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail -->
                                        <Border Grid.Column="0" Height="54" Width="96" Background="#09090B" CornerRadius="4">
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TargetName}" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBlock Text="{Binding FormattedDuration}" FontSize="11" Foreground="#60A5FA"/>
                                                <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="#71717A" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Gallery Footer -->
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="Open Folder" Click="BtnOpenMediaFolder_Click" Background="#27272A" HorizontalAlignment="Left"/>
                        <Button Content="Rescan" Click="BtnRescan_Click" Background="#27272A" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="#18181B" HorizontalAlignment="Stretch"/>

            <!-- Right: Editor, Trim, Audio, & Discord Share -->
            <Grid Grid.Column="2" Margin="16" Background="#0F0F12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Actions -->
                    <RowDefinition Height="2*"/>   <!-- Player -->
                    <RowDefinition Height="Auto"/> <!-- Player Scrubber -->
                    <RowDefinition Height="Auto"/> <!-- Trim Controls -->
                    <RowDefinition Height="Auto"/> <!-- Audio Mix Controls -->
                    <RowDefinition Height="Auto"/> <!-- Discord Export & Share -->
                </Grid.RowDefinitions>

                <!-- Selected Clip Title & Delete/Rename -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedClip.Title, FallbackValue='No Clip Selected'}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedClip.FormattedDuration, StringFormat=' ({0})'}" FontSize="14" Foreground="#60A5FA" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Rename" Click="BtnRename_Click" Margin="0,0,8,0" Background="#27272A"/>
                        <Button Content="Delete" Click="BtnDelete_Click" Background="#7F1D1D" Foreground="#FCA5A5"/>
                    </StackPanel>
                </DockPanel>

                <!-- Video Player -->
                <Border Grid.Row="1" Background="#000000" CornerRadius="6" ClipToBounds="True">
                    <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  ScrubbingEnabled="True" Stretch="Uniform"
                                  MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded" MediaFailed="VideoPlayer_MediaFailed"/>
                </Border>

                <!-- Player Transport Controls -->
                <Grid Grid.Row="2" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0"><Button x:Name="BtnPlayPause" Content="▶ Play" Click="BtnPlayPause_Click" Width="80" Margin="0,0,10,0"/><Button Content="Open Player" Click="OpenInPlayer_Click" Margin="0,0,10,0"/></StackPanel>
                    <Slider x:Name="PlayerSlider" Grid.Column="1" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                            ValueChanged="PlayerSlider_ValueChanged" PreviewMouseLeftButtonDown="PlayerSlider_MouseDown" PreviewMouseLeftButtonUp="PlayerSlider_MouseUp"/>
                    <TextBlock x:Name="TxtPlayerTime" Grid.Column="2" Text="0:00 / 0:00" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#A1A1AA"/>
                </Grid>

                <!-- Trim Controls -->
                <Border Grid.Row="3" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Trim Start:" VerticalAlignment="Center" Grid.Row="0"/>
                        <Slider x:Name="SliderTrimStart" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="0" Value="{Binding SelectedClip.TrimStartSeconds, Mode=TwoWay}"
                                ValueChanged="TrimSliders_ValueChanged"/>
                        <TextBlock x:Name="TxtTrimStart" Grid.Row="0" Grid.Column="2" Text="{Binding SelectedClip.TrimStartSeconds, StringFormat='{}{0:F1}s'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Text="Trim End:" VerticalAlignment="Center" Grid.Row="1" Margin="0,8,0,0"/>
                        <Slider x:Name="SliderTrimEnd" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,8,0,0"
                                Minimum="0" Value="{Binding SelectedClip.TrimEndSeconds, Mode=TwoWay}"
                                ValueChanged="TrimSliders_ValueChanged"/>
                        <TextBlock x:Name="TxtTrimEnd" Grid.Row="1" Grid.Column="2" Text="{Binding SelectedClip.TrimEndSeconds, StringFormat='{}{0:F1}s'}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Audio Mixer Controls -->
                <Border Grid.Row="4" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Audio Tracks (Source Isolation &amp; Levels)" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedClip.AudioTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <CheckBox Grid.Column="1" Content="Mute" IsChecked="{Binding IsMuted, Mode=TwoWay}" Click="AudioMuteChanged" VerticalAlignment="Center" Foreground="#EF4444"/>
                                        <Slider Grid.Column="2" Minimum="0" Maximum="2.0" Value="{Binding Gain, Mode=TwoWay}" ValueChanged="AudioGainChanged" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Gain, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A1A1AA"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Discord Export & Share Actions -->
                <Border Grid.Row="5" Background="#1C1C24" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <!-- Presets & Export Button -->
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Discord Target:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton Content="20 MB (Free)" IsChecked="True" GroupName="Cap" Click="Preset20_Click" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FAFAFA"/>
                                <RadioButton Content="50 MB" GroupName="Cap" Click="Preset50_Click" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FAFAFA"/>
                                <RadioButton Content="100 MB" GroupName="Cap" Click="Preset100_Click" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FAFAFA"/>
                            </StackPanel>

                            <Button Content="⚡ Export for Discord" Click="BtnExport_Click"
                                    Background="#2563EB" FontWeight="Bold" Padding="16,8" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Progress Bar (while exporting) -->
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ExportProgress}"
                                     Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>

                        <!-- Status text -->
                        <TextBlock Text="{Binding ExportStatusMessage}" Foreground="#93C5FD" FontSize="12" Margin="0,0,0,10"/>

                        <!-- Ready Share Actions (Native Drag & Copy into Discord) -->
                        <Border Background="#18181B" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="10"
                                Visibility="{Binding IsExportReady, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Drag Handle -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Buttons -->
                                </Grid.ColumnDefinitions>

                                <!-- Drag Handle -->
                                <Border x:Name="DragHandle" Grid.Column="0" Background="#16A34A" CornerRadius="4" Padding="14,8"
                                        Cursor="Hand" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                                    <TextBlock Text="✋ DRAG TO DISCORD" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="Share file validated and ready!" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                    <TextBlock Text="{Binding ReadyExportFilePath}" FontSize="11" Foreground="#71717A" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📋 Copy File" Click="BtnCopyFile_Click" Margin="0,0,8,0" Background="#27272A" ToolTip="Copy MP4 to clipboard (Ctrl+V into Discord)"/>
                                    <Button Content="📁 Open Folder" Click="BtnOpenExportFolder_Click" Margin="0,0,8,0" Background="#27272A"/>
                                    <Button Content="🚀 Send to Channel" Click="BtnSendWebhook_Click" Background="#4F46E5" FontWeight="Bold" ToolTip="Send to configured Discord text channel webhook"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#141417" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock Text="{Binding StatusDetails}" Foreground="#A1A1AA" FontSize="12"/>
                <TextBlock Text="Offline Core | Zero Watermarks | No Telemetry | Free Forever" Foreground="#71717A" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
