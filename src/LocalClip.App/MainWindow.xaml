                                <TextBlock x:Name="ShareFormatHint" Visibility="Collapsed" Text="{Binding ShareFormatHint}" Style="{StaticResource Flick.Text.Muted}" TextWrapping="NoWrap" Margin="0,4,0,0" ToolTip="{Binding ExportAspectDescription}"/>
                                <Grid x:Name="ShareRecentExportsRow" Margin="0,6,0,0">
