                                    </Path>
                                    <TextBlock Text="Original" Style="{StaticResource Flick.Text.Caption}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ToolShare" Tag="Share" Click="EditorTool_Click" Style="{StaticResource Flick.Button.Ghost}" MinHeight="52" Padding="8,4" Margin="6,0" ToolTip="Share: export an MP4, copy or drag the file" AutomationProperties.Name="Share" IsEnabled="True">
                                <StackPanel>
                                    <Path Style="{StaticResource Flick.Icon.Tool}" Data="{StaticResource Flick.Icon.Geometry.Share}" Width="20" Height="20"/>
