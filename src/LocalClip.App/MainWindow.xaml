                                </Grid>
                            </StackPanel>
                        </Border></Grid></DockPanel></Border></Grid>
        </Grid>

        <!-- R1: Settings/Folders are hosted in the same Flick window.
             Pages are created lazily and removed on navigation. -->
        <Border x:Name="WorkspacePageLayer" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Panel.ZIndex="10" Background="{DynamicResource Flick.Brush.Canvas}">
            <ContentControl x:Name="WorkspacePageHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Border>

        <!-- Same-window health disclosure: errors survive footer and host changes. -->
        <Border x:Name="RecordingHealthPanel" Grid.Row="1" Grid.Column="1" Panel.ZIndex="30" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="460" MaxHeight="470" Margin="12" Padding="18" Background="{DynamicResource Flick.Brush.Raised}" CornerRadius="12" KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel LastChildFill="True">
                <Grid x:Name="RecordingHealthHeader" DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Recording health" Style="{StaticResource Flick.Text.Section}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCloseRecordingHealth" Grid.Column="1" Content="Close" Style="{StaticResource Flick.Button.Ghost}" Click="BtnCloseRecordingHealth_Click" AutomationProperties.Name="Close recording health"/>
                </Grid>
                <StackPanel x:Name="RecordingDiagnosticsFooter" DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock x:Name="TxtDiagnosticPrivacy" Text="Diagnostics stay on this PC." ToolTip="Diagnostic exports exclude videos, clip titles, paths and credentials." TextWrapping="Wrap" Style="{StaticResource Flick.Text.Caption}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="BtnRunRecordingDiagnostic" Content="{Binding DiagnosticTestActionText}" Click="BtnRunRecordingDiagnostic_Click" IsEnabled="{Binding CanInvokeRecordingDiagnostic}" Margin="0,0,8,0" Style="{StaticResource Flick.Button.Secondary}" AutomationProperties.Name="Run or cancel recording test" AutomationProperties.HelpText="Confirm the exact capture source and audio before recording a short test. A validated test clip is kept in Your Clips."/>
                        <Button x:Name="BtnExportDiagnostics" Content="Export diagnostics" HorizontalAlignment="Left" Click="BtnExportDiagnostics_Click" IsEnabled="{Binding CanExportDiagnostics}" Style="{StaticResource Flick.Button.Secondary}" AutomationProperties.Name="Export redacted diagnostics" AutomationProperties.HelpText="Save a local troubleshooting ZIP with recording states and numeric health details. No videos, titles, paths or credentials."/>
                    </WrapPanel>
                    <CheckBox x:Name="ChkDiagnosticAudio" Content="Include audio" ToolTip="Use your configured system audio and microphone in this test." IsChecked="False" IsEnabled="{Binding CanRunRecordingDiagnostic}" Style="{StaticResource Flick.Input.CheckBox}" Margin="0,7,0,0" AutomationProperties.Name="Include configured audio in recording test" AutomationProperties.HelpText="Off by default. Confirmation names system audio and microphone separately. Your normal recording preferences are kept."/>
                    <TextBlock x:Name="TxtRecordingDiagnosticStatus" Text="{Binding DiagnosticTestStatusText}" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Style="{StaticResource Flick.Text.Caption}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="TxtDiagnosticStatus" Text="{Binding DiagnosticStatusText}" TextWrapping="Wrap" Style="{StaticResource Flick.Text.Caption}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <ScrollViewer x:Name="RecordingHealthScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="TxtHealthStatus" Text="{Binding CaptureStateText}" FontWeight="SemiBold" Foreground="{DynamicResource Flick.Brush.TextPrimary}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding AudioCaptureSummary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding GameDetectionStatus}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding HealthDetailsText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding HealthLastFailureText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding HealthLastSavedText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding HealthHotkeysText}" TextWrapping="Wrap" Foreground="{DynamicResource Flick.Brush.TextSecondary}"/>
                        <TextBlock x:Name="TxtRecordingDiagnosticDetails" Text="{Binding DiagnosticTestDetailsText}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Bottom Status Bar -->
        <Border x:Name="AppStatusBar" Grid.Row="2" Grid.Column="1" Background="{DynamicResource Flick.Brush.Surface}" BorderBrush="{DynamicResource Flick.Brush.Divider}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StatusDetails}" ToolTip="{Binding StatusDetails}" Foreground="{DynamicResource Flick.Brush.TextSecondary}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtResourceStats" Text="{Binding ResourceStatsText}" ToolTip="{Binding ResourceStatsDetails}" Visibility="{Binding ResourceStatsVisible, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding ResourceStatsText}" AutomationProperties.HelpText="{Binding ResourceStatsDetails}" Foreground="{DynamicResource Flick.Brush.TextSecondary}" FontSize="11" TextWrapping="NoWrap" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                    <TextBlock Text="{Binding CaptureEncodingText}" ToolTip="{Binding CaptureEncodingText}" FontSize="12" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CaptureEncodingText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding SoftwareFallbackWarning}" ToolTip="{Binding SoftwareFallbackWarning}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Caption}">
                                <Setter Property="Foreground" Value="{DynamicResource Flick.Brush.Warning}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SoftwareFallbackWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    <Border x:Name="DialogLayer" Visibility="Collapsed" Panel.ZIndex="100" Background="{DynamicResource Flick.Brush.Frosted}" Padding="24" KeyboardNavigation.TabNavigation="Cycle">
        <ContentControl x:Name="DialogContentHost" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"/>
    </Border>
    </Grid>
</Window>
