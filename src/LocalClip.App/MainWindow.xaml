                                <Button Content="Set out (O)" Click="SetTrimOut_Click" Style="{StaticResource Flick.Button.Secondary}" Margin="0,0,8,6" Padding="9,0"/>
                                <Button Content="Undo trim" Click="UndoTrim_Click" IsEnabled="{Binding CanUndoTrim}" Style="{StaticResource Flick.Button.Ghost}" Margin="0,0,8,6" Padding="9,0"/>
                                <Button Content="Add marker (M)" Click="AddMarker_Click" Style="{StaticResource Flick.Button.Ghost}" Margin="0,0,0,6" Padding="9,0"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding EditorSaveState}" Style="{StaticResource Flick.Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <ItemsControl ItemsSource="{Binding ClipMarkers}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Content="{Binding DisplayText}" Tag="{Binding}" Click="SeekMarker_Click" Style="{StaticResource Flick.Button.Ghost}" Padding="8,0" Margin="0,0,6,6" ToolTip="Jump to marker; right-click to remove">
                                        <Button.ContextMenu><ContextMenu><MenuItem Header="Remove marker" Click="RemoveMarker_Click"/></ContextMenu></Button.ContextMenu>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Header="Preview frames" Style="{StaticResource Flick.Expander.Disclosure}" Margin="0,8,0,0">
                                <StackPanel Margin="0,8,0,0">
