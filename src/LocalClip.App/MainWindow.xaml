                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button x:Name="BtnShareDetails" DockPanel.Dock="Right" Content="Details" Click="ShareDetails_Click" Style="{StaticResource Flick.Button.Ghost}" MinHeight="32" MinWidth="60" Padding="8,0" Visibility="{Binding Visibility, ElementName=SharePanel}" ToolTip="Full export status, size and frame details"/>
                                    <TextBlock Text="Share clip" VerticalAlignment="Center" Margin="4,0,12,4">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Flick.Text.Section}">
