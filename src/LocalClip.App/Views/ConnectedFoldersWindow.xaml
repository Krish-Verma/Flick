<UserControl x:Class="LocalClip.App.Views.ConnectedFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="0" MinHeight="0"
        Background="{DynamicResource Flick.Brush.Canvas}"
        Foreground="{DynamicResource Flick.Brush.TextPrimary}"
        FontFamily="{StaticResource Flick.Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Folders_PreviewKeyDown">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Clip folders" Style="{StaticResource Flick.Text.PageTitle}"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Style="{StaticResource Flick.Text.Caption}"
                       Text="Link MP4 and MKV folders. Originals stay in place."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkIncludeSubfolders"
                      Style="{StaticResource Flick.Toggle}" IsChecked="True"
                      Content="Include subfolders" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Add folder"
                    Style="{StaticResource Flick.Button.Primary}"
                    Click="AddFolder_Click"/>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Flick.Brush.Divider}"
                BorderThickness="0,1,0,1" Padding="0,4">
            <ListBox x:Name="FolderList" ItemsSource="{Binding ConnectedFolders}"
                     ItemContainerStyle="{StaticResource Flick.Library.Item}"
                     ToolTip="Select a folder to rescan or unlink."
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,10" MinHeight="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Flick.Text.Control}"
                                           Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                                <TextBlock Style="{StaticResource Flick.Text.Caption}"
                                           Text="{Binding Path}" ToolTip="{Binding Path}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Margin="0,4,12,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource Flick.Text.Caption}"
                                       VerticalAlignment="Center" Text="{Binding Status}"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,24">
            <TextBlock Text="{Binding ImportStatusText}"
                       Style="{StaticResource Flick.Text.Caption}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip="{Binding ImportStatusText}"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Rescan selected"
                    Style="{StaticResource Flick.Button.Secondary}"
                    Click="RescanFolder_Click" Margin="0,0,8,0"
                    ToolTip="Scan this folder again. Scans are bounded and cancelable; recording takes priority. Unavailable folders stay linked."/>
            <Button Grid.Column="1" Content="Unlink folder"
                    Style="{StaticResource Flick.Button.Ghost}"
                    Click="RemoveFolder_Click"/>
            <Button Grid.Column="3" Content="Cancel scan"
                    Style="{StaticResource Flick.Button.Secondary}"
                    Click="CancelScan_Click" Margin="0,0,8,0"/>
            <Button Grid.Column="4" Content="Close"
                    Style="{StaticResource Flick.Button.Secondary}"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</UserControl>
