<Window x:Class="LocalClip.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalClip Settings" Height="520" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#FAFAFA">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="LocalClip Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Hotkeys -->
                <TextBlock Text="Shortcuts" FontWeight="SemiBold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Toggle Capture (Arm/Disarm):" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtToggleHotkey" Grid.Column="1" Margin="0,4" ToolTip="e.g. Ctrl+Shift+F9"/>

                    <TextBlock Grid.Row="1" Text="Save Replay Shortcut:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtSaveHotkey" Grid.Row="1" Grid.Column="1" Margin="0,4" ToolTip="e.g. Ctrl+Shift+F8"/>
                </Grid>

                <Separator Background="#27272A" Margin="0,10,0,15"/>

                <!-- Storage -->
                <TextBlock Text="Media Storage" FontWeight="SemiBold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Originals Folder:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtOriginalsFolder" Grid.Column="1" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Browse..." Click="BrowseOriginals_Click"/>
                </Grid>

                <Separator Background="#27272A" Margin="0,10,0,15"/>

                <!-- Replay Buffer Settings -->
                <TextBlock Text="Capture Profile" FontWeight="SemiBold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Replay Buffer Duration:" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <TextBox x:Name="TxtDuration" Width="60"/>
                        <TextBlock Text="seconds (15 to 120s, default 30s)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#A1A1AA"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Hardware Encoder:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="NVIDIA NVENC H.264 (Hardware accelerated, RTX 5060)" VerticalAlignment="Center" Margin="0,4" Foreground="#34D399"/>
                </Grid>

                <Separator Background="#27272A" Margin="0,10,0,15"/>

                <!-- Discord Webhook -->
                <TextBlock Text="Discord Webhook (Optional M3)" FontWeight="SemiBold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,8"/>
                <TextBlock Text="Secret is securely encrypted using Windows DPAPI (CurrentUser) and never stored in plain text." Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Channel Name / Label:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtWebhookChannel" Grid.Column="1" Margin="0,4" ToolTip="e.g. #general-clips"/>

                    <TextBlock Grid.Row="1" Text="Webhook URL:" VerticalAlignment="Center" Margin="0,4"/>
                    <PasswordBox x:Name="TxtWebhookUrl" Grid.Row="1" Grid.Column="1" Margin="0,4" Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46" Padding="6,4" FontSize="13"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,15,0,0">
            <Button Content="Restore Defaults" Click="RestoreDefaults_Click" HorizontalAlignment="Left" Background="#27272A" Foreground="#EF4444"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Background="#27272A"/>
                <Button Content="Save Settings" Click="Save_Click" Background="#2563EB" FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
