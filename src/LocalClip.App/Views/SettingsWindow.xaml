<Window x:Class="LocalClip.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flick Settings" Height="700" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#FAFAFA">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Flick Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Hotkeys -->
                <TextBlock Text="Shortcuts" FontWeight="SemiBold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Toggle Capture (Arm/Disarm):" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtToggleHotkey" Grid.Column="1" Margin="0,4" ToolTip="e.g. Ctrl+Shift+F9"/>

                    <TextBlock Grid.Row="1" Text="Save Replay Shortcut:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtSaveHotkey" Grid.Row="1" Grid.Column="1" Margin="0,4" ToolTip="e.g. Ctrl+Shift+F8"/>
                </Grid>

                <Separator Background="#27272A" Margin="0,10,0,15"/>

                <!-- Storage -->
                <TextBlock Text="Media Storage" FontWeight="SemiBold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Saved Clips Folder" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtOriginalsFolder" Grid.Column="1" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Browse..." Click="BrowseOriginals_Click"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Export Folder" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtExportsFolder" Grid.Column="1" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Browse…" Click="BrowseExports_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Connected Clip Folders" FontWeight="SemiBold"/>
                        <TextBlock Text="Link existing MP4 and MKV files without copying or moving them."
                                   TextWrapping="Wrap" Foreground="{DynamicResource Flick.Brush.TextSecondary}"
                                   FontSize="12" Margin="0,4,8,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Manage Folders" Click="ManageFolders_Click"
                            Style="{StaticResource Flick.Button.Secondary}"/>
                </Grid>
                <TextBlock Text="Changing locations affects future files only; existing recordings are not moved."
                           TextWrapping="Wrap" Foreground="{DynamicResource Flick.Brush.TextMuted}"
                           FontSize="12" Margin="0,0,0,8"/>
                <Separator Background="#27272A" Margin="0,10,0,15"/>

                <!-- Capture -->
                <TextBlock Text="Replay &amp; Quality" FontWeight="SemiBold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Replay Duration" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <TextBox x:Name="TxtDuration" Width="56" TextChanged="CaptureProfile_Changed"/>
                        <TextBlock Text="seconds (15–120)" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Recording Quality" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbQuality" Width="265" HorizontalAlignment="Left"
                              Background="#27272A" Foreground="#FAFAFA" SelectionChanged="CaptureProfile_Changed">
                        <ComboBoxItem Content="Light — 720p / 30 FPS" Tag="Light"/>
                        <ComboBoxItem Content="Balanced — 1080p / 30 FPS" Tag="Balanced"/>
                        <ComboBoxItem Content="Smooth — 1080p / 60 FPS" Tag="Smooth"/>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="TxtBufferWarning" TextWrapping="Wrap"
                               Foreground="#A1A1AA" FontSize="11" Margin="0,6,0,0"/>
                </Grid>
                <CheckBox x:Name="ChkMicrophone" Content="Record microphone (off by default)" Margin="0,0,0,10"
                          Foreground="#E4E4E7"/>
                <TextBlock Text="System audio is recorded in fallback mode; individual game/Discord tracks are not isolated."
                           TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
                <Separator Background="#27272A" Margin="0,10,0,15"/>

                <!-- Startup -->
                <TextBlock Text="Windows Startup &amp; Tray" FontWeight="SemiBold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkStartWithWindows" Content="Launch Flick when I sign in to Windows"
                          Foreground="#E4E4E7" Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkStartMinimized" Content="Open in the tray (hide the window)"
                          Foreground="#E4E4E7" Margin="0,0,0,6"/>
                <TextBlock Text="Flick always starts with replay capture OFF, including Windows startup."
                           Foreground="#A1A1AA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Separator Background="#27272A" Margin="0,10,0,15"/>

                <!-- Slice 2: small clip feedback, not an always-on game overlay. -->
                <TextBlock Text="Clip Notifications" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource Flick.Brush.Accent}" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkClipSavedOverlay" Content="Show Clip Saved Overlay"
                          Foreground="{DynamicResource Flick.Brush.TextPrimary}"
                          Margin="0,0,0,8" ToolTip="Temporary, non-activating branded confirmation"/>
                <CheckBox x:Name="ChkClipSavedSound" Content="Play Confirmation Sound"
                          Foreground="{DynamicResource Flick.Brush.TextPrimary}"
                          Margin="0,0,0,8" ToolTip="Short Flick confirmation tone; may be audible in system audio loopback"/>
                <TextBlock Text="Both are enabled by default. They work independently and never activate capture."
                           TextWrapping="Wrap" Foreground="{DynamicResource Flick.Brush.TextSecondary}"
                           FontSize="12" Margin="0,0,0,8"/>
                <Button Content="Preview Notification" Click="PreviewNotification_Click"
                        Style="{StaticResource Flick.Button.Secondary}" HorizontalAlignment="Left"
                        Margin="0,0,0,6"/>
                <Separator Background="{DynamicResource Flick.Brush.Border}" Margin="0,10,0,15"/>

                <!-- Discord Webhook -->
                <TextBlock Text="Discord Webhook (Advanced)" FontWeight="SemiBold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,8"/>
                <TextBlock Text="Secret is securely encrypted using Windows DPAPI (CurrentUser) and never stored in plain text." Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Channel Name / Label:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtWebhookChannel" Grid.Column="1" Margin="0,4" ToolTip="e.g. #general-clips"/>

                    <TextBlock Grid.Row="1" Text="Webhook URL:" VerticalAlignment="Center" Margin="0,4"/>
                    <PasswordBox x:Name="TxtWebhookUrl" Grid.Row="1" Grid.Column="1" Margin="0,4" Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46" Padding="6,4" FontSize="13"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,15,0,0">
            <Button Content="Restore Defaults" Click="RestoreDefaults_Click" HorizontalAlignment="Left" Background="#27272A" Foreground="#EF4444"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Background="#27272A"/>
                <Button Content="Save Settings" Click="Save_Click" Background="#2563EB" FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
