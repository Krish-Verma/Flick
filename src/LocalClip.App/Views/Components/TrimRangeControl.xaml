<UserControl x:Class="LocalClip.App.Views.Components.TrimRangeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinHeight="113" Focusable="False">
    <!-- Single timeline with two accessible keyboard/mouse handles. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Trim Clip" Style="{StaticResource Flick.Text.Section}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedDurationText" Text="Selected: 0:00.00"
                           Style="{StaticResource Flick.Text.Caption}" Margin="0,0,10,0"/>
                <Button x:Name="ResetTrimButton" Content="Reset"
                        Style="{StaticResource Flick.Button.Ghost}"
                        Click="ResetTrim_Click" Padding="8,0" MinWidth="48" MinHeight="28"
                        ToolTip="Restore the entire original recording"/>
            </StackPanel>
        </Grid>
        <Canvas Grid.Row="1" x:Name="RangeCanvas" Height="30"
                SizeChanged="RangeCanvas_SizeChanged" ClipToBounds="False"
                Margin="7,0,7,0">
            <Border x:Name="TrackBackground" Canvas.Top="10" Height="11"
                    CornerRadius="3" Background="{DynamicResource Flick.Brush.Raised}"
                    BorderBrush="{DynamicResource Flick.Brush.Border}" BorderThickness="1"/>
            <Border x:Name="SelectedTrack" Canvas.Top="10" Height="11"
                    CornerRadius="3" Background="{DynamicResource Flick.Brush.Raised}"
                    BorderBrush="{DynamicResource Flick.Brush.BorderStrong}" BorderThickness="1"/>
            <primitives:Thumb x:Name="StartHandle" Width="12" Height="28"
                              Focusable="True" IsTabStop="True"
                              Cursor="SizeWE" DragDelta="StartHandle_DragDelta"
                              DragCompleted="Handle_DragCompleted"
                              PreviewKeyDown="Handle_PreviewKeyDown"
                              PreviewKeyUp="Handle_PreviewKeyUp"
                              LostKeyboardFocus="Handle_LostKeyboardFocus"
                              PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown"
                              ToolTip="Drag or use Left/Right arrows to set trim start"
                              AutomationProperties.Name="Trim Start Handle">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border x:Name="Grip" Background="{DynamicResource Flick.Brush.TextSecondary}"
                                BorderBrush="{DynamicResource Flick.Brush.BorderStrong}"
                                BorderThickness="1" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Grip" Property="BorderBrush"
                                        Value="{DynamicResource Flick.Brush.Focus}"/>
                                <Setter TargetName="Grip" Property="Background"
                                        Value="{DynamicResource Flick.Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Grip" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
            <primitives:Thumb x:Name="EndHandle" Width="12" Height="28"
                              Focusable="True" IsTabStop="True"
                              Cursor="SizeWE" DragDelta="EndHandle_DragDelta"
                              DragCompleted="Handle_DragCompleted"
                              PreviewKeyDown="Handle_PreviewKeyDown"
                              PreviewKeyUp="Handle_PreviewKeyUp"
                              LostKeyboardFocus="Handle_LostKeyboardFocus"
                              PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown"
                              ToolTip="Drag or use Left/Right arrows to set trim end"
                              AutomationProperties.Name="Trim End Handle">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border x:Name="Grip" Background="{DynamicResource Flick.Brush.TextSecondary}"
                                BorderBrush="{DynamicResource Flick.Brush.BorderStrong}"
                                BorderThickness="1" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Grip" Property="BorderBrush"
                                        Value="{DynamicResource Flick.Brush.Focus}"/>
                                <Setter TargetName="Grip" Property="Background"
                                        Value="{DynamicResource Flick.Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Grip" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Canvas>
        <Grid Grid.Row="2" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Start" Style="{StaticResource Flick.Text.Caption}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="StartTimeBox"
                     Style="{StaticResource Flick.Input.Text}"
                     Padding="6,6" FontSize="{StaticResource Flick.Font.Control}" Typography.NumeralAlignment="Tabular"
                     AutomationProperties.Name="Trim Start Time"
                     LostKeyboardFocus="TimeBox_LostKeyboardFocus"
                     PreviewKeyDown="TimeBox_PreviewKeyDown"
                     ToolTip="Enter seconds or M:SS.ff"/>
            <TextBlock Grid.Column="3" Text="End" Style="{StaticResource Flick.Text.Caption}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="4" x:Name="EndTimeBox"
                     Style="{StaticResource Flick.Input.Text}"
                     Padding="6,6" FontSize="{StaticResource Flick.Font.Control}" Typography.NumeralAlignment="Tabular"
                     AutomationProperties.Name="Trim End Time"
                     LostKeyboardFocus="TimeBox_LostKeyboardFocus"
                     PreviewKeyDown="TimeBox_PreviewKeyDown"
                     ToolTip="Enter seconds or M:SS.ff"/>
        </Grid>
    </Grid>
</UserControl>
