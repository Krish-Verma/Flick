<UserControl x:Class="LocalClip.App.Views.Components.FlickClipToast"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="278" MinHeight="64"
             Focusable="False">
    <!-- One image, filling one squircle. No second circle or gradient divider bar. -->
    <Border Style="{StaticResource Flick.Surface.Toast}" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Style="{StaticResource Flick.Image.BrandMark}"
                   Width="38" Height="38"
                   ToolTip="Flick"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                <TextBlock Style="{StaticResource Flick.Text.Control}"
                           Text="{Binding Heading, ElementName=Root}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock Style="{StaticResource Flick.Text.Caption}" Margin="0,2,0,0"
                           Text="{Binding Detail, ElementName=Root}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
            <Path Grid.Column="2" Data="M 2,9 L 7,14 L 16,4"
                  Stroke="{DynamicResource Flick.Brush.Success}"
                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="16" Height="18" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
