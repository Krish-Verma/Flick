<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LocalClip.Core\LocalClip.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Flick</AssemblyName>
    <RootNamespace>LocalClip.App</RootNamespace>
    <Product>Flick</Product>
    <Title>Flick Gameplay Clipper</Title>
    <Authors>Flick Contributors</Authors>
    <Version>1.0.10-preview.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\Brand\Flick.ico</ApplicationIcon>
    <GeneratedFlickLogo>obj\$(Configuration)\$(TargetFramework)\Brand\FlickLogo.png</GeneratedFlickLogo>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- The canonical SVG is an editable source of truth. Generate the branded
         PNG under obj/ so builds NEVER modify the older tracked bitmap. WPF's
         pack URI still sees exactly Assets/Brand/FlickLogo.png. -->
    <Resource Include="$(GeneratedFlickLogo)">
      <Link>Assets\Brand\FlickLogo.png</Link>
      <LogicalName>Assets/Brand/FlickLogo.png</LogicalName>
    </Resource>
  </ItemGroup>

  <!-- Produce both the circular transparent PNG and all Windows icon sizes
       from the SAME vector source before WPF resources/compilation. -->
  <Target Name="GenerateFlickIcon"
          BeforeTargets="AssignTargetPaths;PrepareResources;MarkupCompilePass1;CoreCompile"
          Inputs="Assets\Brand\FlickMark.svg;..\..\scripts\build_flick_icon.ps1"
          Outputs="$(GeneratedFlickLogo);Assets\Brand\Flick.ico">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\Brand" />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -STA -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build_flick_icon.ps1&quot; -InputSvg &quot;$(MSBuildProjectDirectory)\Assets\Brand\FlickMark.svg&quot; -OutputPng &quot;$(MSBuildProjectDirectory)\$(GeneratedFlickLogo)&quot; -OutputIco &quot;$(MSBuildProjectDirectory)\Assets\Brand\Flick.ico&quot;" />
  </Target>
</Project>
