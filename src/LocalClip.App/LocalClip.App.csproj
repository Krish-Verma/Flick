<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LocalClip.Core\LocalClip.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the full squircle artwork into the portable WPF assembly.
         A runtime absolute path or external logo download is not allowed. -->
    <None Remove="Assets\Brand\FlickLogo.png" />
    <Resource Include="Assets\Brand\FlickLogo.png" />
  </ItemGroup>

</Project>
